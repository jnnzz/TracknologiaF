# Application environment mode: 'local' (or 'development'), 'staging', 'production', or 'test'.
# NODE_ENV=production is always authoritative and cannot be downgraded by APP_ENV.
APP_ENV=local

# Application origin URL (used for password reset emails and absolute redirect callbacks)
# Required. Must use HTTPS and non-localhost origin in production.
# Example: http://localhost:3000 (development) or https://app.tracknologia.com (production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase public project configuration
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only service credential used by public operations (Tracking lookup,
# Tracking observation, Repair Request submission) so the publishable key
# cannot reach Postgres directly. NEVER expose through NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only HMAC key for opaque public-operation abuse-control actor keys.
# Must be at least 32 random characters.
PUBLIC_ABUSE_HMAC_SECRET=
# Separate proof shared only by the app and its trusted production ingress.
# Must be at least 32 random characters and distinct from HMAC secret when
# trusted ingress is required. Local shared-bucket mode may leave this blank.
PUBLIC_ABUSE_TRUSTED_PROXY_SECRET=
# Local development only: place every request in one shared abuse-control
# bucket instead of requiring trusted ingress proof. FORBIDDEN in staging
# or production (causes startup failure); leave blank/false in production.
PUBLIC_ABUSE_SHARED_DEV_BUCKET=true
# Where the visitor IP for abuse control comes from. Unset or 'trusted-proxy'
# (default) requires the proxy secret and verified ingress headers. 'vercel'
# trusts only x-vercel-forwarded-for and is accepted only when VERCEL=1, which
# Vercel sets on its deployments. Never set it anywhere else.
# PUBLIC_ABUSE_CLIENT_IP_SOURCE=

# Optional validated rate-limit policy overrides (defaults shown).
PUBLIC_ABUSE_TRACKING_LOOKUP_MAX=30
PUBLIC_ABUSE_TRACKING_LOOKUP_WINDOW_SECONDS=60
PUBLIC_ABUSE_REPAIR_REQUEST_MAX=5
PUBLIC_ABUSE_REPAIR_REQUEST_WINDOW_SECONDS=600
PUBLIC_ABUSE_FEEDBACK_MAX=20
PUBLIC_ABUSE_FEEDBACK_WINDOW_SECONDS=600

# Email Delivery Configuration (SMTP through nodemailer)
# Set SMTP_HOST, SMTP_USER and SMTP_PASSWORD together, plus EMAIL_FROM, or leave SMTP unset.
# With none: local development logs email info to the console; production sends
# no invitation email and invitations are shared with Copy Link.
# Brevo: smtp-relay.brevo.com, port 587, the SMTP login from its dashboard,
# and an SMTP key (not an API key or Gmail password). Keep SMTP_PASSWORD secret.
# Configure Supabase Auth SMTP separately for confirmation/recovery email (docs/SETUP.md).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Required when SMTP is set: Tracknologia <your-verified-sender-address>.
# SMTP_USER can be a technical login and is never used as the sender fallback.
EMAIL_FROM=

# Email Confirmation Toggle
# Set to 'false' to skip email confirmation in development only.
# FORBIDDEN to set to false in production (causes startup failure).
NEXT_PUBLIC_REQUIRE_EMAIL_CONFIRMATION=false

# End-to-end (Playwright) test configuration
# Runs `pnpm test:e2e`. The E2E fixtures seed actors/tenants and delete them via
# the service-role key, so they refuse to run against anything but a disposable
# LOCAL Supabase stack (localhost / 127.0.0.1). Start one with `supabase start`
# and run `pnpm db:reset` before the suite. The three values above must point at
# that local stack; E2E fails fast otherwise.
# E2E_BASE_URL defaults to http://localhost:3000 (the Playwright webServer).
# E2E_BASE_URL=http://localhost:3000

# Never add Supabase service-role/secret values with NEXT_PUBLIC_ prefixes.
